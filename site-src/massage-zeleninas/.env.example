# ============================================================
# massage-zeleninas — персональная страница
# Скопируй в .env и заполни. .env НЕ коммитится (в .gitignore).
# ============================================================

# --- Публичные ссылки на платформы ---
FB_URL=https://www.facebook.com/massage.zeleninas/
IG_URL=https://www.instagram.com/massage_zeleninas/
YT_URL=https://www.youtube.com/@massage_zeleninas
TG_URL=https://t.me/massage_zeleninas

# --- WhatsApp ---
# Вариант A (рекомендуется): номер в международном формате (можно с + и пробелами —
# build.py уберёт все нецифровые символы). Пример: +201019661628.
WA_PHONE=+201019661628

# Вариант B: если позже перейдёшь на имя (@massage_zeleninas), можно задать
# готовую ссылку wa.me напрямую и закомментировать WA_PHONE:
# WA_URL=https://wa.me/71234567890

# --- Сайт (для og:url и футера) ---
# URL, где живёт страница в проде
SITE_URL=https://dizel0110.github.io/massage-zeleninas/
